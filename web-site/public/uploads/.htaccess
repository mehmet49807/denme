# Deny script execution under user uploads
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

<FilesMatch "\.(?i:php|phtml|phar|cgi|pl|py|jsp|asp|aspx|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
