RewriteEngine On
RewriteBase /

# Chicken subdomain uses a self-signed cert; send HTTP visitors to the
# main domain path that has a valid Let's Encrypt certificate.
RewriteCond %{HTTP_HOST} ^chicken\.gonulkoprusu\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://gonulkoprusu.com/chicken/$1 [R=302,L,QSA]

# Block sensitive paths (tools = emergency scripts; not public)
RewriteRule ^(config|app|sql|storage|tools)/ - [F,L]

# Short cache for brand logos so updates show quickly
<IfModule mod_headers.c>
  <FilesMatch "(logo|brand).*\.(png|svg|jpg|jpeg|webp)$">
    Header set Cache-Control "public, max-age=120, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# QR menü her zaman front controller'dan geçsin
# (FTP bazen qr/ klasörü bırakır; klasör varken /qr beyaz/boş kalır)
RewriteRule ^qr/?$ index.php [L,QSA]
RewriteRule ^qr/brosur\.png$ index.php [L,QSA]

# Front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
