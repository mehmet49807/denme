RewriteEngine On
RewriteBase /

# Chicken subdomain uses a self-signed cert; send HTTP visitors to the
# main domain path that has a valid Let's Encrypt certificate.
RewriteCond %{HTTP_HOST} ^chicken\.gonulkoprusu\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://gonulkoprusu.com/chicken/$1 [R=302,L,QSA]

# Block sensitive paths
RewriteRule ^(config|app|sql|storage)/ - [F,L]

# Front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
