# GitHub Actions deploy secrets — kopyalayın: cp .env.deploy.example .env.deploy
# .env.deploy dosyası git'e eklenmez.

FTP_WEB_USER=web@gonulkoprusu.com
FTP_WEB_PASSWORD=

FTP_ADMIN_USER=panel@admin.gonulkoprusu.com
FTP_ADMIN_PASSWORD=

# Generate a long random value (openssl rand -hex 32) and set the same in
# GitHub Secrets + hosting .env for both web and admin.
SETUP_CACHE_KEY=

# Opsiyonel (script varsayılanları)
GITHUB_REPO=mehmet49807/denme
DEPLOY_BRANCH=cursor/github-auto-deploy-9613
DEPLOY_BASE=master

# Admin panelden Deploy tetikleme + Secrets API için (repo + actions:write)
# Hosting .env içine: DEPLOY_GITHUB_TOKEN=ghp_xxx
DEPLOY_GITHUB_TOKEN=
